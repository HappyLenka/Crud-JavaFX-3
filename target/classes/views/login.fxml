<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="500.0" prefWidth="700.0"
   style="-fx-background-color: linear-gradient(from 0% 0% to 60% 100%, #1e2d3d 0%, #2d3f55 60%, #1a2a3a 100%);"
   xmlns="http://javafx.com/javafx/25"
   xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.emma.controllers.LoginController">
   <children>

      <VBox alignment="CENTER" maxWidth="300" spacing="14"
         style="-fx-background-color: #28394f;
                   -fx-background-radius: 16;
                   -fx-border-color: #3e6080;
                   -fx-border-radius: 16;
                   -fx-border-width: 1;
                   -fx-padding: 40 35 40 35;
                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 20, 0, 0, 6);">
         <children>

            <!-- Avatar circular con libro -->
            <StackPane alignment="CENTER">
               <Circle radius="52" fill="#2a7a94" />
               <Label text="📖" style="-fx-font-size: 48;" />
            </StackPane>

            <!-- Título (messageLabel) -->
            <Label fx:id="messageLabel" text="Login"
               maxWidth="Infinity" alignment="CENTER"
               style="-fx-text-fill: white;
                          -fx-font-size: 18;
                          -fx-font-weight: bold;">
               <VBox.margin>
                  <Insets top="8" bottom="4" />
               </VBox.margin>
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>

            <!-- Campo usuario -->
            <TextField fx:id="usernameField"
               promptText="Usuario"
               style="-fx-background-color: transparent;
                              -fx-border-color: #3e6080;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #6a8099;
                              -fx-padding: 10 12 10 12;
                              -fx-font-size: 13;" />

            <!-- Campo contraseña -->
            <PasswordField fx:id="passwordField"
               promptText="Contraseña"
               style="-fx-background-color: transparent;
                                  -fx-border-color: #3e6080;
                                  -fx-border-radius: 6;
                                  -fx-background-radius: 6;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #6a8099;
                                  -fx-padding: 10 12 10 12;
                                  -fx-font-size: 13;" />

            <!-- Botón login -->
            <Button fx:id="buttonLogin"
               text="Aceptar"
               onAction="#handleLogin"
               maxWidth="Infinity"
               style="-fx-background-color: transparent;
                           -fx-border-color: #3e6080;
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-text-fill: #8aabb8;
                           -fx-cursor: hand;
                           -fx-padding: 10;
                           -fx-font-size: 13;">
               <VBox.margin>
                  <Insets top="6" />
               </VBox.margin>
            </Button>

         </children>
      </VBox>

   </children>
</StackPane>