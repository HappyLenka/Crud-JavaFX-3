<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="420.0" prefWidth="780.0" style="-fx-background-color: linear-gradient(from 0% 0% to 60% 100%, #1e2d3d 0%, #2d3f55 60%, #1a2a3a 100%);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.emma.controllers.mainController">

   <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>

   <left>
      <!-- Panel izquierdo: formulario -->
      <VBox prefWidth="280" spacing="14" style="-fx-background-color: #28394f;                    -fx-background-radius: 14;                    -fx-border-color: #3e6080;                    -fx-border-radius: 14;                    -fx-border-width: 1;                    -fx-padding: 30 25 30 25;                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 16, 0, 0, 4);">
         <BorderPane.margin><Insets right="20" /></BorderPane.margin>

         <!-- Título del panel -->
         <Label style="-fx-text-fill: white;                        -fx-font-size: 15;                        -fx-font-weight: bold;" text="📖  Gestión de Libros">
            <VBox.margin><Insets bottom="6" /></VBox.margin>
         </Label>

         <!-- ID -->
         <Label style="-fx-text-fill: #8aabb8; -fx-font-size: 12;" text="ID" />
         <TextField fx:id="tfId" disable="true" style="-fx-background-color: #1e2d3d;                            -fx-border-color: #3e6080;                            -fx-border-radius: 6;                            -fx-background-radius: 6;                            -fx-text-fill: #6a8099;                            -fx-prompt-text-fill: #4a6070;                            -fx-padding: 8 12 8 12;                            -fx-font-size: 13;                            -fx-opacity: 0.7;" />

         <!-- Título -->
         <Label style="-fx-text-fill: #8aabb8; -fx-font-size: 12;" text="Título" />
         <TextField fx:id="tfTitle" style="-fx-background-color: transparent;                            -fx-border-color: #3e6080;                            -fx-border-radius: 6;                            -fx-background-radius: 6;                            -fx-text-fill: white;                            -fx-prompt-text-fill: #6a8099;                            -fx-padding: 8 12 8 12;                            -fx-font-size: 13;" />

         <!-- Autor -->
         <Label style="-fx-text-fill: #8aabb8; -fx-font-size: 12;" text="Autor" />
         <TextField fx:id="tfAuthor" style="-fx-background-color: transparent;                            -fx-border-color: #3e6080;                            -fx-border-radius: 6;                            -fx-background-radius: 6;                            -fx-text-fill: white;                            -fx-prompt-text-fill: #6a8099;                            -fx-padding: 8 12 8 12;                            -fx-font-size: 13;" />

         <!-- Año -->
         <Label style="-fx-text-fill: #8aabb8; -fx-font-size: 12;" text="Año" />
         <TextField fx:id="tfYear" style="-fx-background-color: transparent;                            -fx-border-color: #3e6080;                            -fx-border-radius: 6;                            -fx-background-radius: 6;                            -fx-text-fill: white;                            -fx-prompt-text-fill: #6a8099;                            -fx-padding: 8 12 8 12;                            -fx-font-size: 13;" />

         <!-- Páginas -->
         <Label style="-fx-text-fill: #8aabb8; -fx-font-size: 12;" text="Páginas" />
         <TextField fx:id="tfPages" style="-fx-background-color: transparent;                            -fx-border-color: #3e6080;                            -fx-border-radius: 6;                            -fx-background-radius: 6;                            -fx-text-fill: white;                            -fx-prompt-text-fill: #6a8099;                            -fx-padding: 8 12 8 12;                            -fx-font-size: 13;" />

         <!-- Botones -->
         <HBox alignment="CENTER" spacing="8">
            <VBox.margin><Insets top="10" /></VBox.margin>
            <Button fx:id="btnInsert" contentDisplay="GRAPHIC_ONLY" maxWidth="Infinity" onAction="#handleBtnAction" prefHeight="52.0" prefWidth="70.0" style="-fx-background-color: transparent;                            -fx-border-color: #3e6080;                            -fx-border-radius: 6;                            -fx-background-radius: 6;                            -fx-text-fill: #8aabb8;                            -fx-cursor: hand;                            -fx-padding: 8;                            -fx-font-size: 12;" text="Insertar" HBox.hgrow="ALWAYS">
               <graphic>
                  <ImageView fitHeight="26.0" fitWidth="29.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../icons/insertar.png" />
                     </image>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </ImageView>
               </graphic></Button>
            <Button fx:id="btnUpdate" contentDisplay="GRAPHIC_ONLY" maxWidth="Infinity" onAction="#handleBtnAction" prefHeight="52.0" prefWidth="70.0" style="-fx-background-color: transparent;                            -fx-border-color: #3e6080;                            -fx-border-radius: 6;                            -fx-background-radius: 6;                            -fx-text-fill: #8aabb8;                            -fx-cursor: hand;                            -fx-padding: 8;                            -fx-font-size: 12;" text="Actualizar" HBox.hgrow="ALWAYS">
               <graphic>
                  <ImageView fitHeight="26.0" fitWidth="29.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../icons/actualizar.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            <Button fx:id="btnDelete" contentDisplay="GRAPHIC_ONLY" maxWidth="Infinity" onAction="#handleBtnAction" prefHeight="52.0" prefWidth="71.0" style="-fx-background-color: transparent;                            -fx-border-color: #c0392b;                            -fx-border-radius: 6;                            -fx-background-radius: 6;                            -fx-text-fill: #e07070;                            -fx-cursor: hand;                            -fx-padding: 8;                            -fx-font-size: 12;" text="Eliminar" HBox.hgrow="ALWAYS">
               <graphic>
                  <ImageView fitHeight="26.0" fitWidth="29.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../icons/eliminar.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
         </HBox>

      </VBox>
   </left>

   <center>
      <!-- Panel derecho: tabla -->
      <VBox spacing="10" style="-fx-background-color: #28394f;                    -fx-background-radius: 14;                    -fx-border-color: #3e6080;                    -fx-border-radius: 14;                    -fx-border-width: 1;                    -fx-padding: 25;                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 16, 0, 0, 4);">

         <Label style="-fx-text-fill: white;                        -fx-font-size: 14;                        -fx-font-weight: bold;" text="Listado de Libros">
            <VBox.margin><Insets bottom="4" /></VBox.margin>
         </Label>

         <TableView fx:id="tbBooks" style="-fx-background-color: #1e2d3d;                            -fx-border-color: #3e6080;                            -fx-border-radius: 8;                            -fx-background-radius: 8;                            -fx-table-cell-border-color: #2d3f55;                            -fx-control-inner-background: #1e2d3d;                            -fx-text-fill: white;" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colId" prefWidth="55" style="-fx-text-fill: white;" text="id" />
               <TableColumn fx:id="colTitle" prefWidth="130" style="-fx-text-fill: white;" text="titulo" />
               <TableColumn fx:id="colAuthor" prefWidth="110" style="-fx-text-fill: white;" text="autor" />
               <TableColumn fx:id="colYear" prefWidth="65" style="-fx-text-fill: white;" text="año" />
               <TableColumn fx:id="colPages" prefWidth="75" style="-fx-text-fill: white;" text="páginas" />
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         </TableView>

      </VBox>
   </center>

</BorderPane>
